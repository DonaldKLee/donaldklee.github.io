# Optional. The site already ships Donald's GA4 property (G-EGDELZ6371), so
# analytics works on the deployed site with no configuration.
#
# Set this only to point a build at a *different* property. Doing so also opts
# localhost in, which is how you test events locally without polluting the real
# reports — by default local dev never reports at all.
#
# Copy to .env.local to use.
NEXT_PUBLIC_GA_ID=
